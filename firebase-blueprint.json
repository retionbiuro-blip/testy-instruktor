{
  "entities": {
    "SystemMetadata": {
      "title": "SystemMetadata",
      "description": "Global database version counter, category registry, and optional NotebookLM link used to avoid redundant full-collection reads.",
      "type": "object",
      "properties": {
        "dbVersion": {
          "type": "number",
          "description": "Incrementing version number bumped on every question, category, or lesson change."
        },
        "categories": {
          "type": "array",
          "description": "List of available driving instructor exam categories."
        },
        "notebookLmUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional public share URL to the Google NotebookLM legal assistant notebook."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last metadata update."
        }
      },
      "required": ["dbVersion", "categories"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Structured legal theory and study chapter grouped by exam category with Markdown content and key exam takeaways.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "order": {
          "type": "number"
        },
        "legalBasis": {
          "type": "string",
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "keyTakeaways": {
          "type": "string",
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "category", "title", "order", "legalBasis", "content", "keyTakeaways"]
    },
    "Question": {
      "title": "Question",
      "description": "Driving instructor exam question with multiple-choice options and optional compressed Base64 image.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionHash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "licenseCategory": {
          "type": "string",
          "enum": ["B", "A", "C", "D", "T", "TRAM", "ALL"],
          "maxLength": 10,
          "description": "Optional driving license category (B, A, C, D, T, TRAM, or ALL for shared questions). Missing/null defaults to Kat. B."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "options": {
          "type": "array",
          "description": "Answer options without A/B/C prefixes."
        },
        "correctAnswers": {
          "type": "array",
          "description": "Zero-based indices of correct answers (1 to 3 items)."
        },
        "imageBase64": {
          "type": "string",
          "maxLength": 300000
        },
        "hasImagePlaceholder": {
          "type": "boolean"
        },
        "explanation": {
          "type": "string",
          "maxLength": 4000
        },
        "importBatchId": {
          "type": "string",
          "maxLength": 128
        },
        "importBatchLabel": {
          "type": "string",
          "maxLength": 200
        },
        "wrongCount": {
          "type": "number",
          "description": "Cumulative counter of incorrect answers across students for Top 20 hardest questions."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "questionHash", "category", "question", "options", "correctAnswers", "hasImagePlaceholder"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Shared student comment or group note attached to a question.",
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorNick": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["questionId", "authorNick", "authorUid", "text", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Student-submitted error report for a question with admin reply and user read tracking.",
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userNick": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "reason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "adminReply": {
          "type": "string",
          "maxLength": 2000
        },
        "repliedAt": {
          "type": "string",
          "format": "date-time"
        },
        "isReadByUser": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["questionId", "questionText", "category", "userId", "userNick", "reason", "status", "adminReply", "repliedAt", "isReadByUser", "createdAt"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Private student learning progress, mistake streaks, lecturer bookmarks, completed lessons, and private notes.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nick": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "masteredIds": {
          "type": "array"
        },
        "completedLessonIds": {
          "type": "array"
        },
        "mistakeStreaks": {
          "type": "object"
        },
        "askLecturerIds": {
          "type": "array"
        },
        "privateNotes": {
          "type": "object"
        },
        "savedOutlines": {
          "type": "array",
          "description": "List of up to 50 saved lesson plan outlines synced with the student's account."
        },
        "totalAnswered": {
          "type": "number"
        },
        "totalCorrect": {
          "type": "number"
        },
        "points": {
          "type": "number"
        },
        "streakDays": {
          "type": "number"
        },
        "lastStudyDate": {
          "type": "string",
          "maxLength": 20
        },
        "examHistory": {
          "type": "array"
        },
        "unreadNotifications": {
          "type": "number",
          "description": "Count of unread admin replies to the student's error reports."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "nick", "email", "masteredIds", "mistakeStreaks", "askLecturerIds", "privateNotes", "totalAnswered", "totalCorrect", "points", "streakDays"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public non-PII course ranking statistics for a student.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nick": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "masteredCount": {
          "type": "number"
        },
        "points": {
          "type": "number"
        },
        "streakDays": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "nick", "masteredCount", "points", "streakDays", "accuracy"]
    },
    "LegalAct": {
      "title": "LegalAct",
      "description": "Full legal act, regulation, or PDF document shared with students via Google Drive or external URL.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "enum": ["ustawa", "rozporzadzenie", "inne"]
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "type", "description", "url", "order"]
    },
    "ExamTopic": {
      "title": "ExamTopic",
      "description": "Oral lecture presentation exam topic with commission tips and a model Markdown lesson outline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "commissionTips": {
          "type": "string",
          "maxLength": 2000
        },
        "sampleOutline": {
          "type": "string",
          "maxLength": 50000
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "category", "title", "commissionTips", "sampleOutline", "order"]
    },
    "SystemStats": {
      "title": "SystemStats",
      "description": "Lightweight shared statistics document holding cumulative wrong-answer counts per question ID.",
      "type": "object",
      "properties": {
        "wrongCounts": {
          "type": "object",
          "description": "Map of question ID to total incorrect answers count across students."
        }
      },
      "required": ["wrongCounts"]
    },
    "GlossaryTerm": {
      "title": "GlossaryTerm",
      "description": "Didactics, methodology, and psychology glossary flashcard term with definition and driving-school example.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "example": {
          "type": "string",
          "maxLength": 5000
        },
        "order": {
          "type": "number"
        },
        "examTip": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "category", "term", "definition", "example", "order"]
    }
  },
  "firestore": {
    "/system/metadata": {
      "schema": "SystemMetadata",
      "description": "Single metadata document tracking dbVersion, category list, and NotebookLM URL."
    },
    "/system/stats": {
      "schema": "SystemStats",
      "description": "Single lightweight stats document storing wrongCounts map independent of IndexedDB question cache."
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Master bank of driving instructor exam questions."
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Knowledge base theory chapters and legal foundations for driving instructor candidates."
    },
    "/legalActs/{actId}": {
      "schema": "LegalAct",
      "description": "Full-text legal acts, regulations, and PDF documents for driving instructor candidates."
    },
    "/examTopics/{topicId}": {
      "schema": "ExamTopic",
      "description": "Oral lecture presentation exam topics with commission tips and model outlines."
    },
    "/glossaryTerms/{termId}": {
      "schema": "GlossaryTerm",
      "description": "Didactics, methodology, and psychology flashcard glossary terms."
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Shared group notes and comments under questions."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Student error reports on questions for admin review."
    },
    "/users/{userId}": {
      "schema": "UserProgress",
      "description": "Private student progress, notes, completed lessons, and PII."
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Public non-PII ranking entry per student."
    }
  }
}
